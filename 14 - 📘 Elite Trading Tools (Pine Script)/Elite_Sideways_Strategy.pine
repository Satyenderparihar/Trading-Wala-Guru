// Elite Sideways Strategy v1.0

//@version=5
strategy("Sideways Strategy Pro (Backtestable)", "Elite Strategy", overlay=true, 
     initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.03)

// ==========================================
// INPUTS
// ==========================================
grp_adx = "ADX Trend Strength"
adx_len = input.int(14, "ADX Length", minval=1, group=grp_adx)
adx_threshold = input.int(20, "ADX Sideways Threshold", minval=1, group=grp_adx)

grp_chop = "Choppiness Index"
chop_len = input.int(14, "Chop Length", minval=1, group=grp_chop)
chop_threshold = input.float(61.8, "Chop Sideways Threshold", minval=1, group=grp_chop)

grp_bb = "Bollinger Squeeze"
bb_len = input.int(20, "BB Length", minval=1, group=grp_bb)
bb_std = input.float(2.0, "BB StdDev", minval=0.1, group=grp_bb)
bbw_lookback = input.int(100, "BBW Squeeze Lookback", minval=1, group=grp_bb)
bbw_percentile = input.int(25, "BBW Squeeze Percentile (%)", minval=1, maxval=100, group=grp_bb)

grp_lr = "Trend Settings"
linreg_length = input.int(11, "LinReg Length", minval=1, maxval=200, group=grp_lr)

// ==========================================
// CALCULATIONS - Sideways logic
// ==========================================
[diplus, dimin, adx_val] = ta.dmi(adx_len, adx_len)
is_adx_sideways = adx_val < adx_threshold

sum_true_range = ta.rma(ta.tr(true), chop_len) * chop_len
chop_val = 100 * math.log10(sum_true_range / (ta.highest(high, chop_len) - ta.lowest(low, chop_len))) / math.log10(chop_len)
is_chop_sideways = chop_val > chop_threshold

[basis, upper_bb, lower_bb] = ta.bb(close, bb_len, bb_std)
bbw = (upper_bb - lower_bb) / basis
bbw_threshold = ta.percentile_linear_interpolation(bbw, bbw_lookback, bbw_percentile)
is_bbw_squeeze = bbw < bbw_threshold

int score = (is_adx_sideways ? 1 : 0) + (is_chop_sideways ? 1 : 0) + (is_bbw_squeeze ? 1 : 0)
bool is_sideways = score >= 2

// ==========================================
// TREND LOGIC
// ==========================================
bopen  = ta.linreg(open,  linreg_length, 0)
bclose = ta.linreg(close, linreg_length, 0)
r = bopen < bclose

// Strategy Logic
longCondition  = r and not r[1] and not is_sideways
shortCondition = not r and r[1] and not is_sideways

// ==========================================
// EXECUTION
// ==========================================
if (longCondition)
    strategy.entry("Long", strategy.long, comment="Trend BUY")

if (shortCondition)
    strategy.entry("Short", strategy.short, comment="Trend SELL")

// Exit on trend flip OR if market goes sideways
if (is_sideways)
    strategy.close_all(comment="Sideways Exit")

// ==========================================
// VISUALS
// ==========================================
plotcandle(r ? bopen : na, r ? ta.linreg(high, linreg_length, 0) : na, r ? ta.linreg(low, linreg_length, 0) : na, r ? bclose : na, color=color.new(color.blue, 50), bordercolor=color.black)
plotcandle(not r ? bopen : na, not r ? ta.linreg(high, linreg_length, 0) : na, not r ? ta.linreg(low, linreg_length, 0) : na, not r ? bclose : na, color=color.new(color.white, 50), bordercolor=color.black)

bgcolor(is_sideways ? color.new(color.orange, 85) : na, title="Sideways Filter")
