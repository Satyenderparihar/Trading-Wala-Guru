//@version=5
indicator("Sideways Market Detector Premium", "Sideways Detector", overlay=true, max_labels_count=500, max_lines_count=500)

// ==========================================
// INPUTS - Sideways Detection
// ==========================================
grp_adx = "ADX Trend Strength"
adx_len = input.int(14, "ADX Length", minval=1, group=grp_adx)
adx_threshold = input.int(20, "ADX Sideways Threshold", minval=1, group=grp_adx)

grp_chop = "Choppiness Index"
chop_len = input.int(14, "Chop Length", minval=1, group=grp_chop)
chop_threshold = input.float(61.8, "Chop Sideways Threshold", minval=1, group=grp_chop)

grp_bb = "Bollinger Squeeze"
bb_len = input.int(20, "BB Length", minval=1, group=grp_bb)
bb_std = input.float(2.0, "BB StdDev", minval=0.1, group=grp_bb)
bbw_lookback = input.int(100, "BBW Squeeze Lookback", minval=1, group=grp_bb)
bbw_percentile = input.int(25, "BBW Squeeze Percentile (%)", minval=1, maxval=100, group=grp_bb)

// ==========================================
// INPUTS - LinReg Candles
// ==========================================
grp_lr = "Linear Regression Candles"
lin_reg = input.bool(true, "Show LinReg Candles", group=grp_lr)
linreg_length = input.int(11, "LinReg Length", minval=1, maxval=200, group=grp_lr)
filter_signals = input.bool(true, "Filter Signals in Sideways Mode", group=grp_lr, tooltip="Only show Buy/Sell signals when market is NOT sideways")

grp_vis = "Visuals & Dashboard"
show_bg = input.bool(true, "Show Sideways Background", group=grp_vis)
side_color = input.color(color.new(color.gray, 85), "Sideways Color", group=grp_vis)
show_dashboard = input.bool(true, "Show Info Dashboard", group=grp_vis)

// ==========================================
// CALCULATIONS - Sideways logic
// ==========================================

// 1. ADX Calculation
[diplus, dimin, adx_val] = ta.dmi(adx_len, adx_len)
is_adx_sideways = adx_val < adx_threshold

// 2. Choppiness Index Calculation
sum_true_range = ta.rma(ta.tr(true), chop_len) * chop_len
highest_high = ta.highest(high, chop_len)
lowest_low = ta.lowest(low, chop_len)
chop_val = 100 * math.log10(sum_true_range / (highest_high - lowest_low)) / math.log10(chop_len)
is_chop_sideways = chop_val > chop_threshold

// 3. Bollinger Band Width Squeeze
[basis, upper_bb, lower_bb] = ta.bb(close, bb_len, bb_std)
bbw = (upper_bb - lower_bb) / basis
bbw_threshold = ta.percentile_linear_interpolation(bbw, bbw_lookback, bbw_percentile)
is_bbw_squeeze = bbw < bbw_threshold

// Final Sideways Logic (2 out of 3)
int score = (is_adx_sideways ? 1 : 0) + (is_chop_sideways ? 1 : 0) + (is_bbw_squeeze ? 1 : 0)
bool is_sideways = score >= 2

// ==========================================
// CALCULATIONS - LinReg Candles (v5)
// ==========================================
bopen  = lin_reg ? ta.linreg(open,  linreg_length, 0) : open
bhigh  = lin_reg ? ta.linreg(high,  linreg_length, 0) : high
blow   = lin_reg ? ta.linreg(low,   linreg_length, 0) : low
bclose = lin_reg ? ta.linreg(close, linreg_length, 0) : close

// Bullish / Bearish Condition
r = bopen < bclose

// Signal Logic
raw_buySignal  = r and not r[1]
raw_sellSignal = not r and r[1]

// Apply Filtering
buySignal  = filter_signals ? (raw_buySignal and not is_sideways) : raw_buySignal
sellSignal = filter_signals ? (raw_sellSignal and not is_sideways) : raw_sellSignal

// ==========================================
// VISUALS
// ==========================================

// Highlight Background
bgcolor(show_bg and is_sideways ? side_color : na, title="Sideways Zone")

// Plot Custom Candles
plotcandle(r ? bopen : na, r ? bhigh : na, r ? blow : na, r ? bclose : na, title="Bullish LinReg", color=color.rgb(0, 102, 255), wickcolor=color.black, bordercolor=color.black)
plotcandle(r ? na : bopen, r ? na : bhigh, r ? na : blow, r ? na : bclose, title="Bearish LinReg", color=color.white, wickcolor=color.black, bordercolor=color.black)

// Triangle Signals
plotshape(buySignal,  title="Buy Triangle",  location=location.belowbar, style=shape.triangleup,   color=color.green, size=size.small)
plotshape(sellSignal, title="Sell Triangle", location=location.abovebar, style=shape.triangledown, color=color.red,   size=size.small)

// Dashboard Table
var dashboard = table.new(position.top_right, 2, 6, color.new(color.black, 20))

if show_dashboard and barstate.islast
    table.cell(dashboard, 0, 0, "Metric", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 0, "Status", text_color=color.white, text_halign=text.align_center)
    
    table.cell(dashboard, 0, 1, "Market State", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 1, is_sideways ? "SIDEWAYS" : "TRENDING", bgcolor=is_sideways ? color.new(color.orange, 50) : color.new(color.green, 50), text_color=color.white)
    
    table.cell(dashboard, 0, 2, "LinReg Trend", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 2, r ? "BULL" : "BEAR", bgcolor=r ? color.new(color.blue, 50) : color.new(color.gray, 50), text_color=color.white)

    table.cell(dashboard, 0, 3, "ADX (Trend)", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 3, str.format("{0,number,#.##}", adx_val), bgcolor=is_adx_sideways ? color.new(color.red, 50) : color.new(color.green, 50), text_color=color.white)
    
    table.cell(dashboard, 0, 4, "Chop Index", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 4, str.format("{0,number,#.##}", chop_val), bgcolor=is_chop_sideways ? color.new(color.red, 50) : color.new(color.green, 50), text_color=color.white)
    
    table.cell(dashboard, 0, 5, "BB Width", text_color=color.white, text_halign=text.align_left)
    table.cell(dashboard, 1, 5, is_bbw_squeeze ? "SQUEEZE" : "NORMAL", bgcolor=is_bbw_squeeze ? color.new(color.red, 50) : na, text_color=color.white)

// ==========================================
// ALERTS
// ==========================================
alertcondition(buySignal,  title="Buy Alert",  message="LinReg BUY Signal")
alertcondition(sellSignal, title="Sell Alert", message="LinReg SELL Signal")
alertcondition(is_sideways and not is_sideways[1], "Enter Sideways", "Market defined as sideways")
alertcondition(not is_sideways and is_sideways[1], "Exit Sideways", "Market is starting to trend")
